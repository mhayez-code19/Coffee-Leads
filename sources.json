{
  "_doc": "One entry per dataset. See README.md for every key. signal = what kind of opening evidence the record is (drives the score).",
  "sources": [
    {
      "id": "chicago_food_license_inspections",
      "jurisdiction": "Chicago, IL",
      "state": "IL",
      "level": "city",
      "type": "socrata",
      "domain": "data.cityofchicago.org",
      "dataset": "4ijn-s7e5",
      "portal_url": "https://data.cityofchicago.org/d/4ijn-s7e5",
      "signal": "pre_opening_inspection",
      "date_field": "inspection_date",
      "extra_where": "inspection_type = 'License'",
      "filter_fields": [
        "dba_name",
        "aka_name",
        "facility_type"
      ],
      "fields": {
        "id": "inspection_id",
        "name": "dba_name",
        "alt_name": "aka_name",
        "address": "address",
        "city": "city",
        "state": "state",
        "zip": "zip",
        "category": "facility_type",
        "event_type": "inspection_type",
        "status": "results",
        "lat": "latitude",
        "lon": "longitude",
        "date": "inspection_date"
      }
    },
    {
      "id": "chicago_new_business_licenses",
      "jurisdiction": "Chicago, IL",
      "state": "IL",
      "level": "city",
      "type": "socrata",
      "domain": "data.cityofchicago.org",
      "dataset": "r5kz-chrr",
      "portal_url": "https://data.cityofchicago.org/d/r5kz-chrr",
      "signal": "new_business_license",
      "date_field": "license_start_date",
      "extra_where": "application_type = 'ISSUE'",
      "filter_fields": [
        "doing_business_as_name",
        "legal_name"
      ],
      "fields": {
        "id": "license_id",
        "name": "doing_business_as_name",
        "alt_name": "legal_name",
        "address": "address",
        "city": "city",
        "state": "state",
        "zip": "zip_code",
        "category": "business_activity",
        "event_type": "license_description",
        "status": "license_status",
        "lat": "latitude",
        "lon": "longitude",
        "date": "license_start_date"
      },
      "exclude_status": "^(REV|INQ)$"
    },
